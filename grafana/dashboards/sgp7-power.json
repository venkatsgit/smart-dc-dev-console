      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "smartdc-postgres-prod"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH sensor_meta AS (\n  SELECT sm.sensor_id,\n         CASE WHEN am.asset_name LIKE 'HT-%'\n              THEN 'COOLING-SYSTEM-GBR-TS'\n              ELSE 'LTCH-SYSTEM-GBR'\n         END AS use_case\n  FROM sgp7.sensor_master sm\n  JOIN sgp7.asset_master am ON am.asset_id = sm.asset_id\n  WHERE sm.sensor_id = '${sensors}'\n),\nhas_pred AS (\n  SELECT 1\n  FROM sgp7.anomaly_predictions p\n  JOIN sensor_meta sm\n    ON sm.sensor_id = p.sensor_id AND sm.use_case = p.use_case\n  WHERE p.sensor_id = sm.sensor_id\n    AND $__timeFilter(p.eventdatetime)\n  LIMIT 1\n)\nSELECT p.eventdatetime AS \"time\",\n       'actual' AS metric,\n       p.actual_value::double precision AS value\nFROM sgp7.anomaly_predictions p\nJOIN sensor_meta sm\n  ON sm.sensor_id = p.sensor_id AND sm.use_case = p.use_case\nWHERE p.sensor_id = '${sensors}'\n  AND $__timeFilter(p.eventdatetime)\nUNION ALL\nSELECT p.eventdatetime AS \"time\",\n       'predicted' AS metric,\n       p.predicted_value::double precision AS value\nFROM sgp7.anomaly_predictions p\nJOIN sensor_meta sm\n  ON sm.sensor_id = p.sensor_id AND sm.use_case = p.use_case\nWHERE p.sensor_id = '${sensors}'\n  AND $__timeFilter(p.eventdatetime)\nUNION ALL\nSELECT t.eventdatetime AS \"time\",\n       'telemetry' AS metric,\n       t.value::double precision AS value\nFROM sgp7.telemetry_sensors_1min_agg t\nWHERE t.sensorid = '${sensors}'\n  AND $__timeFilter(t.eventdatetime)\n  AND NOT EXISTS (SELECT 1 FROM has_pred)\nORDER BY 1",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "${sensors:text}",
      "type": "timeseries",
      "description": "Actual/predicted combined kW when a preferred model is available; otherwise 1-minute telemetry."
    }
