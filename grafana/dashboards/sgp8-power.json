        "definition": "SELECT sm.sensor_id AS __value,\n       COALESCE(NULLIF(am.asset_name, ''), am.asset_id) || ' | ' ||\n       COALESCE(NULLIF(sm.sensor_name, ''), sm.sensor_id) AS __text\nFROM sgp8.sensor_master sm\nJOIN sgp8.asset_master am ON am.asset_id = sm.asset_id\nWHERE sm.asset_id IN ('D_100','D_101','D_102','D_103','D_104','D_105','D_106','D_110','D_111')\n  AND sm.sensor_name ~ '^(CH|CWP|CHWP)-KW(_A|_B|-COMBINED|)$'\nORDER BY am.asset_name, sm.sensor_name",
        "description": "Search and multi-select combined kW sensors across nine chillers.",
