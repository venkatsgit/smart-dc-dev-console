      "pluginVersion": "11.5.2",
      "repeat": "sensors",
      "repeatDirection": "h",
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "smartdc-postgres-prod"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH has_pred AS (\n  SELECT 1\n  FROM sgp8.anomaly_predictions p\n  WHERE p.sensor_id = '${sensors}'\n    AND p.use_case = 'HTCH-SYSTEM-GBR'\n    AND $__timeFilter(p.eventdatetime)\n  LIMIT 1\n)\nSELECT p.eventdatetime AS \"time\",\n       'actual' AS metric,\n       p.actual_value::double precision AS value\nFROM sgp8.anomaly_predictions p\nWHERE p.sensor_id = '${sensors}'\n  AND p.use_case = 'HTCH-SYSTEM-GBR'\n  AND $__timeFilter(p.eventdatetime)\n  AND EXISTS (SELECT 1 FROM has_pred)\nUNION ALL\nSELECT p.eventdatetime AS \"time\",\n       'predicted' AS metric,\n       p.predicted_value::double precision AS value\nFROM sgp8.anomaly_predictions p\nWHERE p.sensor_id = '${sensors}'\n  AND p.use_case = 'HTCH-SYSTEM-GBR'\n  AND $__timeFilter(p.eventdatetime)\n  AND EXISTS (SELECT 1 FROM has_pred)\nUNION ALL\nSELECT t.eventdatetime AS \"time\",\n       'telemetry' AS metric,\n       t.value::double precision AS value\nFROM sgp8.telemetry_sensors_1min_agg t\nWHERE t.sensorid = '${sensors}'\n  AND $__timeFilter(t.eventdatetime)\n  AND NOT EXISTS (SELECT 1 FROM has_pred)\nORDER BY 1",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "${sensors:text}",
      "type": "timeseries"
    }
  ],
  "preload": false,
  "refresh": "1m",
  "schemaVersion": 40,
