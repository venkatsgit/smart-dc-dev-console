{
  "uid": "sgp8-vsd",
  "title": "SGP8 VSD Trends (Dev)",
  "description": "SGP8_DEV Variable Speed Drive trends for cooling towers and related pumps. All VSD sensors selected by default. Source dropdown chooses telemetry or anomaly_predictions directly. Default last 24 hours (SGT).",
  "tags": [
    "smart-dc",
    "sgp8",
    "sgp8_dev",
    "vsd",
    "trends"
  ],
  "timezone": "Asia/Singapore",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "liveNow": false,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "weekStart": "",
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "source",
        "label": "Source",
        "description": "Query telemetry_sensors_1min_agg or anomaly_predictions directly (no auto-fallback).",
        "type": "custom",
        "datasource": null,
        "query": "telemetry,anomaly_predictions",
        "options": [
          {
            "text": "telemetry",
            "value": "telemetry",
            "selected": true
          },
          {
            "text": "anomaly_predictions",
            "value": "anomaly_predictions"
          }
        ],
        "current": {
          "text": "telemetry",
          "value": "telemetry"
