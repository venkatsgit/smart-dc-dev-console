  "fault_definitions": [
    {
      "instance": "F01",
      "id": "chiller.condenser_fouling",
      "name": "Condenser fouling",
      "category": "Centrifugal chiller",
      "applies_to": [
        "chiller"
      ],
      "targets": [
        {
          "variable": "fouling_resistance",
          "part": "condenser",
          "weight": 1.0,
          "scale": 1.0
        }
      ],
      "mechanism": "Scale and biofilm build on the condenser tube bore, adding thermal resistance in series with the clean conductance. To reject the same heat through a worse exchanger the condensing temperature must rise, which widens the condenser approach and increases the lift the compressor works against. Higher lift costs power directly, and it erodes surge margin, because the head the impeller must develop rises while its speed has not. The machine therefore becomes both less efficient and less stable, and at part load the two combine: the capacity loop wants to unload but the lift will not permit the speed reduction that unloading needs.",
      "signature": [
        {
          "signal": "cond_UA_W_K",
          "direction": "fall",
          "order": 1,
          "note": "conductance falls with the added resistance"
        },
        {
          "signal": "cond_approach_K",
          "direction": "rise",
          "order": 2,
          "note": "the primary observable for this fault"
        },
        {
          "signal": "T_cond_K",
          "direction": "rise",
          "order": 2,
          "note": "condensing temperature rises"
        },
        {
          "signal": "P_cond_Pa",
          "direction": "rise",
          "order": 3,
          "note": "along the saturation line"
        },
        {
          "signal": "power_elec_W",
          "direction": "rise",
          "order": 4,
          "note": "more lift, more work"
        },
        {
          "signal": "kW_per_RT",
          "direction": "rise",
          "order": 4,
          "note": "efficiency degrades"
        },
        {
          "signal": "surge_margin",
          "direction": "fall",
          "order": 5,
          "note": "the operating point moves toward the boundary"
        }
      ],
      "default_profile": {
        "kind": "logistic",
        "onset_s": 0.0,
        "duration_s": 172800.0,
        "final_severity": 0.9,
        "initial_severity": 0.0,
        "doubling_s": 600.0,
        "steepness": 8.0,
        "period_s": 600.0,
        "duty": 0.3,
        "points": []
      },
      "typical_ttf_h": [
        24.0,
        720.0
      ],
      "terminal": "high_condenser_pressure",
      "severity_label": "Fouling resistance at the declared limit (1.5e-7 K/W, about a fifth of the clean conductance)",
      "version": "1.0.0"
    }
  ],
